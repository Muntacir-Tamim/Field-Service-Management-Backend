// ============================================================
// ASSIGNMENT — Step 4, 5 of workflow
// Template: PH Healthcare → Schedule model
//
// Workflow:
//   Manager assigns technician → Schedule Visit
//
// Healthcare parallel:
//   Doctor creates schedule → Patient books appointment slot
//
// Key difference:
//   Healthcare Schedule was created by Doctor (supply side)
//   FSM Assignment is created by Manager (demand side, after request exists)
//
// Reschedule logic:
//   Cancel current Assignment (status = CANCELLED)
//   Create a new Assignment with new time
//   WorkOrder stays linked to the latest CONFIRMED Assignment
// ============================================================

model Assignment {
  id             String           @id @default(uuid())
  status         AssignmentStatus @default(PENDING)
  scheduledStart DateTime         // Step 5 — when the visit is scheduled
  scheduledEnd   DateTime
  actualStart    DateTime?        // Step 6 — when technician actually started
  actualEnd      DateTime?        // Step 8 — when work actually ended
  notes          String?          // dispatcher notes
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // which service request this assignment is for (Step 4)
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // which technician is assigned (Step 4)
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Step 5 onwards — work order is created when assignment is CONFIRMED
  workOrder WorkOrder?

  // A technician cannot have two PENDING/CONFIRMED assignments at the same time slot
  // Healthcare equivalent: @@unique([patientId, doctorId, scheduleId]) on Appointment
  @@unique([technicianId, scheduledStart, scheduledEnd, status], name: "unique_technician_slot")

  @@index([serviceRequestId], name: "idx_assignment_serviceRequestId")
  @@index([technicianId],     name: "idx_assignment_technicianId")
  @@index([status],           name: "idx_assignment_status")
  @@index([scheduledStart],   name: "idx_assignment_scheduledStart")
  @@map("assignments")
}
