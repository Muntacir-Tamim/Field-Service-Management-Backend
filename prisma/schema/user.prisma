// ============================================================
// USER — Field Service Management System
// Template: PH Healthcare → User model
//
// Healthcare:  User → Patient | Doctor
// FSM:         User → Customer | Technician | Manager
//
// Manager covers both Dispatcher/Manager AND Finance/Admin roles.
// No separate FinanceUser model — Role enum handles the difference.
// ============================================================

model User {
  id                 String       @id @default(uuid())
  name               String
  email              String       @unique
  password           String?
  googleId           String?      @unique
  authProvider       AuthProvider @default(CREDENTIAL)
  emailVerified      Boolean      @default(false)
  role               Role         @default(CUSTOMER)
  status             UserStatus   @default(ACTIVE)
  needPasswordChange Boolean      @default(false)
  imageUrl           String       @default("")
  imagePublicId      String       @default("")
  isDeleted          Boolean      @default(false)
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // role-based profiles — same pattern as Patient/Doctor in healthcare
  customer   Customer?
  technician Technician?
  manager    Manager?

  @@map("users")
}
