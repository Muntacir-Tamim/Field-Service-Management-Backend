model Technician {
  id                 String                       @id @default(uuid())
  name               String
  email              String                       @unique
  contactNumber      String?
  gender             Gender?
  address            String?
  bio                String?
  experienceYears    Int                          @default(0)
  verificationStatus TechnicianVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedAt         DateTime?
  isAvailable        Boolean                      @default(true)
  isDeleted          Boolean                      @default(false)
  deletedAt          DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  skills      TechnicianSkill[]
  assignments Assignment[]
  // NOTE: WorkOrder is accessed via assignment.workOrder — no direct relation needed

  @@index([email], name: "idx_technician_email")
  @@index([isAvailable], name: "idx_technician_isAvailable")
  @@map("technicians")
}

// Skill master table — seeded by admin
model Skill {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "Electrical Wiring", "HVAC Repair", "Plumbing"
  category    String            // e.g. "Electrical", "Plumbing", "HVAC"
  description String?
  createdAt   DateTime @default(now())

  technicians TechnicianSkill[]

  @@map("skills")
}

// Junction table — Technician ↔ Skill (many-to-many)
model TechnicianSkill {
  technicianId String
  skillId      String
  level        SkillLevel @default(INTERMEDIATE)
  certifiedAt  DateTime?

  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([technicianId, skillId])
  @@map("technician_skills")
}

model Manager {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  contactNumber String?
  department    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  reviewedRequests ServiceRequest[]

  @@map("managers")
}

model FinanceUser {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  contactNumber String?
  department    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("finance_users")
}
