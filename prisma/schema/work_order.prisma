// ============================================================
// WORK ORDER — Step 5 through 9 of workflow
// Template: PH Healthcare → Appointment (status fields) + recordUrl
//
// Workflow:
//   Schedule Visit → Technician Arrives → Work Started
//   → Work Completed → (Invoice)
//
// Healthcare parallel:
//   Appointment.joiningTime   → WorkOrder.startedAt
//   Appointment.recordUrl     → WorkOrder.completionImageUrl
//   Appointment.status        → WorkOrder.status (state machine)
//
// WorkOrder is created when Assignment is CONFIRMED.
// WorkOrder status drives the technician's live updates (Steps 5-9).
// ============================================================

model WorkOrder {
  id                 String          @id @default(uuid())
  status             WorkOrderStatus @default(SCHEDULED)

  // Step 7 — technician fills this when work starts
  problemFound    String?
  workDescription String?

  // Step 8 — technician fills this when work is done
  laborHours         Decimal? @db.Decimal(5, 2)
  completionNotes    String?
  completionImageUrl String?  // proof of work — same as Appointment.recordUrl
  completionPublicId String?

  // timestamps for each stage of the state machine
  startedAt   DateTime? // IN_PROGRESS
  completedAt DateTime? // COMPLETED
  verifiedAt  DateTime? // VERIFIED (manager closes the work order)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // one work order per assignment
  assignmentId String     @unique
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // parts used during the job (replaces partsUsed Json — now queryable)
  parts WorkOrderPart[]

  // Step 9 — service report written after work is done
  serviceReport ServiceReport?

  // Step 10 — invoice generated from this work order
  payment Payment?

  // extra photos/files technician uploads during the job
  attachments WorkOrderAttachment[]

  @@index([status], name: "idx_wo_status")
  @@map("work_orders")
}

// Parts and materials used during the job
// Queryable — unlike a Json field, you can sum costs, filter by part name etc.
model WorkOrderPart {
  id        String   @id @default(uuid())
  name      String
  quantity  Int      @default(1)
  unitCost  Decimal  @db.Decimal(10, 2)
  totalCost Decimal  @db.Decimal(10, 2) // quantity * unitCost (stored for reporting)
  notes     String?
  createdAt DateTime @default(now())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workOrderId], name: "idx_wo_part_workOrderId")
  @@map("work_order_parts")
}

// Service report — written by technician after completing the job
// Healthcare equivalent: Appointment.prescriptionUrl (the formal document after the visit)
model ServiceReport {
  id              String   @id @default(uuid())
  summary         String
  findings        String
  recommendations String?
  reportUrl       String?  // uploaded PDF or doc
  reportPublicId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("service_reports")
}

// Photos/files technician uploads during the job (before/after photos etc.)
// Healthcare equivalent: Appointment.recordUrl (but multiple files)
model WorkOrderAttachment {
  id        String   @id @default(uuid())
  url       String
  publicId  String
  fileType  String
  fileName  String?
  createdAt DateTime @default(now())

  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workOrderId], name: "idx_woa_workOrderId")
  @@map("work_order_attachments")
}
