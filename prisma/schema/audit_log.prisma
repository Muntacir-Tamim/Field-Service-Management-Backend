model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  actorRole  String   @default("SYSTEM")
  action     String
  entity     String
  entityId   String
  fromStatus String?
  toStatus   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId], name: "idx_audit_entity")
  @@index([actorId], name: "idx_audit_actor")
  @@index([action], name: "idx_audit_action")
  @@index([createdAt], name: "idx_audit_createdAt")
  @@map("audit_logs")
}