model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String        @unique
  status      InvoiceStatus @default(DRAFT)
  subtotal    Decimal       @db.Decimal(10, 2)
  taxAmount   Decimal       @db.Decimal(10, 2) @default(0)
  discount    Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount Decimal       @db.Decimal(10, 2)
  dueDate     DateTime?
  sentAt      DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  financeUserId String?
  financeUser   FinanceUser? @relation(fields: [financeUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  lineItems InvoiceItem[]
  payment   Payment?

  @@index([status], name: "idx_invoice_status")
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([invoiceId], name: "idx_invoice_item_invoiceId")
  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(uuid())
  status          PaymentStatus @default(UNPAID)
  method          PaymentMethod @default(CASH)
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("BDT")
  transactionId   String?       @unique 
  payerReference  String?               
  gatewayResponse Json?
  refundAmount    Decimal?      @db.Decimal(10, 2)
  refundReason    String?
  refundedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  invoiceId String  @unique
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("payments")
}
