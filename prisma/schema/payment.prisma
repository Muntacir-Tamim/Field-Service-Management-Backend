// ============================================================
// PAYMENT — Step 10 of workflow
// Template: PH Healthcare → Payment model
//
// Workflow:
//   Work Completed → Invoice/Payment → Customer Feedback
//
// Healthcare parallel:
//   Payment was linked to Appointment (one-to-one)
//   FSM Payment is linked to WorkOrder (one-to-one) — same pattern
//
// Simplification vs your original schema:
//   Removed separate Invoice model — Invoice fields merged into Payment.
//   Reason: In healthcare there was no Invoice model either.
//   If you need multi-line invoices later, InvoiceItem can be added.
//
// Payment fields map:
//   Healthcare                    → FSM
//   merchantInvoiceNumber         → invoiceNumber
//   bkashPaymentId                → gatewayPaymentId
//   bkashTrxId                    → transactionId
//   payerReference                → payerReference
//   gatewayResponse (Json)        → gatewayResponse (Json)
//   refundTrxId/Amount/Reason     → same
// ============================================================

model Payment {
  id            String        @id @default(uuid())
  status        PaymentStatus @default(UNPAID)
  method        PaymentMethod @default(CASH)

  // invoice fields (merged — no separate Invoice model needed for simple cases)
  invoiceNumber String  @unique // generated invoice number shown to customer
  subtotal      Decimal @db.Decimal(10, 2)
  taxAmount     Decimal @db.Decimal(10, 2) @default(0)
  discount      Decimal @db.Decimal(10, 2) @default(0)
  totalAmount   Decimal @db.Decimal(10, 2)
  dueDate       DateTime?
  notes         String?

  // payment gateway fields — same as Healthcare Payment model
  currency         String  @default("BDT")
  gatewayPaymentId String? @unique // bKash payment ID etc.
  transactionId    String? @unique // bKash/Nagad TrxID
  payerReference   String?         // customer email or phone
  gatewayResponse  Json?

  // refund fields — same as Healthcare Payment model
  refundTransactionId String?
  refundAmount        Decimal? @db.Decimal(10, 2)
  refundReason        String?
  refundedAt          DateTime?

  sentAt    DateTime? // when invoice was sent to customer
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // one payment per work order — same pattern as Healthcare (one payment per appointment)
  workOrderId String    @unique
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([status], name: "idx_payment_status")
  @@map("payments")
}
