// ============================================================
// PROFILES — Customer, Technician, Manager
// Template: PH Healthcare → Patient model, Doctor model
//
// Workflow position:
//   Customer   = who raises the service request        (Step 1)
//   Technician = who does the field work               (Step 4-8)
//   Manager    = who reviews, assigns & handles finance (Step 3, 4, 10)
// ============================================================

// ------ CUSTOMER ------
// Healthcare template: Patient model
model Customer {
  id            String    @id @default(uuid())
  contactNumber String?
  gender        Gender?
  address       String?
  city          String?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  serviceRequests ServiceRequest[]   // Step 1
  feedbacks       CustomerFeedback[] // Step 11

  @@index([isDeleted], name: "idx_customer_isDeleted")
  @@map("customers")
}

// ------ TECHNICIAN ------
// Healthcare template: Doctor model
// verificationStatus pattern = DoctorVerificationStatus
// reviewedBy audit field = Doctor.reviewedBy
model Technician {
  id                 String                       @id @default(uuid())
  contactNumber      String?
  gender             Gender?
  address            String?
  bio                String?
  experienceYears    Int                          @default(0)
  verificationStatus TechnicianVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?   // manager userId — audit trail
  reviewedAt         DateTime?
  isAvailable        Boolean   @default(true)
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  skills      TechnicianSkill[]  // what work can this technician do
  assignments Assignment[]       // Step 4-5

  @@index([isAvailable], name: "idx_technician_isAvailable")
  @@index([verificationStatus], name: "idx_technician_verificationStatus")
  @@map("technicians")
}

// Skill catalog — what kinds of work exist
model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  technicians TechnicianSkill[]

  @@map("skills")
}

// Junction: which technician has which skill at what level
// Healthcare equivalent: Doctor.qualifications (normalized)
model TechnicianSkill {
  technicianId String
  skillId      String
  level        SkillLevel @default(INTERMEDIATE)
  certifiedAt  DateTime?

  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([technicianId, skillId])
  @@map("technician_skills")
}

// ------ MANAGER ------
// Replaces Manager + FinanceUser (two models with identical fields)
// User.role = MANAGER → reviews requests, assigns technicians
// User.role = ADMIN   → can also manage invoices
// One model, Role enum handles the distinction
model Manager {
  id            String    @id @default(uuid())
  contactNumber String?
  department    String?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  reviewedRequests ServiceRequest[] // Step 3

  @@map("managers")
}
