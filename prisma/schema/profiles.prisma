model Customer {
  id            String    @id @default(uuid())
  name          String
  email         String       @unique
  contactNumber String?
  gender        Gender?
  address       String?
  city          String?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  serviceRequests ServiceRequest[]   
  feedbacks       CustomerFeedback[] 

  @@index([isDeleted], name: "idx_customer_isDeleted")
  @@map("customers")
}

model Technician {
  id                 String                       @id @default(uuid())
  name               String
  email              String       @unique
  contactNumber      String?
  gender             Gender?
  address            String?
  bio                String?
  experienceYears    Int                          @default(0)
  verificationStatus TechnicianVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedBy         String?   
  reviewedAt         DateTime?
  isAvailable        Boolean   @default(true)

  resumeUrl          String?
  resumePublicId     String?
  documents          Json?    

  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  skills      TechnicianSkill[]  
  assignments Assignment[]      


  @@index([isAvailable], name: "idx_technician_isAvailable")
  @@index([verificationStatus], name: "idx_technician_verificationStatus")
  @@map("technicians")
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  technicians TechnicianSkill[]

  @@map("skills")
}

model TechnicianSkill {
  technicianId String
  skillId      String
  level        SkillLevel @default(INTERMEDIATE)
  certifiedAt  DateTime?

  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([technicianId, skillId])
  @@map("technician_skills")
}

model Admin {
  id            String    @id @default(uuid())
  name          String
  email         String       @unique
  contactNumber String?
  department    String?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  reviewedRequests ServiceRequest[] // Step 3

  @@map("admins")
}
