// Service Request lifecycle - state machine
// PENDING → UNDER_REVIEW → ASSIGNED → SCHEDULED → IN_PROGRESS → COMPLETED
enum ServiceRequestStatus {
  PENDING
  UNDER_REVIEW
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

// Work Order state machine
// CREATED → DISPATCHED → TECHNICIAN_EN_ROUTE → ARRIVED → WORK_STARTED → WORK_COMPLETED → VERIFIED → CLOSED
enum WorkOrderStatus {
  CREATED
  DISPATCHED
  TECHNICIAN_EN_ROUTE
  ARRIVED
  WORK_STARTED
  WORK_COMPLETED
  VERIFIED
  CLOSED
}

