// ------ User & Auth ------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER    // reviews service requests, assigns technicians
  TECHNICIAN // does the actual field work
  CUSTOMER   // raises service requests
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AuthProvider {
  GOOGLE
  CREDENTIAL
}

// ------ Core Workflow State Machines ------

// Step 1-3 in workflow: Customer → Service Request → Manager Review
// PENDING → UNDER_REVIEW → APPROVED → REJECTED | CANCELLED
enum ServiceRequestStatus {
  PENDING       // customer just submitted
  UNDER_REVIEW  // manager is reviewing
  APPROVED      // manager approved, ready for assignment
  REJECTED      // manager rejected
  CANCELLED     // customer cancelled
  COMPLETED     // entire workflow done
}

// Step 4 in workflow: Technician Assignment
// PENDING → CONFIRMED → CANCELLED
enum AssignmentStatus {
  PENDING    // technician assigned, not yet confirmed
  CONFIRMED  // technician confirmed the visit
  CANCELLED  // cancelled — reschedule creates a new Assignment
}

// Step 5-9 in workflow: Schedule Visit → Work Completed
// SCHEDULED → IN_PROGRESS → COMPLETED → VERIFIED
enum WorkOrderStatus {
  SCHEDULED           // visit is scheduled
  TECHNICIAN_EN_ROUTE // technician is on the way
  ARRIVED             // technician arrived at location
  IN_PROGRESS         // work has started
  COMPLETED           // work is done by technician
  VERIFIED            // manager verified and closed
  CANCELLED
}

// Step 10 in workflow: Invoice / Payment
enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  BKASH
  NAGAD
  CARD
}

// ------ Supporting Enums ------

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum TechnicianVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}


enum NotificationType {
  SERVICE_REQUEST_CREATED
  SERVICE_REQUEST_UNDER_REVIEW
  SERVICE_REQUEST_APPROVED
  SERVICE_REQUEST_REJECTED
  SERVICE_REQUEST_CANCELLED
  ASSIGNMENT_CREATED
  ASSIGNMENT_CONFIRMED
  ASSIGNMENT_CANCELLED
  ASSIGNMENT_RESCHEDULED
  VISIT_REMINDER
  TECHNICIAN_EN_ROUTE
  TECHNICIAN_ARRIVED
  WORK_STARTED
  WORK_COMPLETED
  WORK_VERIFIED
  INVOICE_CREATED
  PAYMENT_RECEIVED
  PAYMENT_REFUNDED
  FEEDBACK_RECEIVED
  TECHNICIAN_APPLICATION_SUBMITTED
  TECHNICIAN_APPLICATION_REVIEWED
  GENERAL
}