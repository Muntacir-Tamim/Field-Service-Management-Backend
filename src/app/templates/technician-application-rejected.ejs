<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Application Update</title>
    <style>
      body { font-family: Arial, sans-serif; background: #f7f7f7; color: #333; }
      .container { max-width: 500px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
      .reason { background: #fff5f5; border-left: 4px solid #e53e3e; padding: 10px 14px; margin: 16px 0; }
      .footer { margin-top: 30px; font-size: 12px; color: #888; }
    </style>
  </head>
  <body>
    <div class="container">
      <h2>Hello <%= name %>,</h2>
      <p>Thank you for applying. Unfortunately your technician application was <strong>not approved</strong>.</p>
      <% if (reason) { %>
      <div class="reason"><strong>Reason:</strong> <%= reason %></div>
      <% } %>
      <p>If you think this was a mistake, please contact our support team.</p>
      <div class="footer">&copy; Field Service Management System. All rights reserved.</div>
    </div>
  </body>
</html>
