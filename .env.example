NODE_ENV=development
PORT=5000

APP_URL=http://localhost:5000

FRONTEND_URL=http://localhost:3000


DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/field_service

# ── JWT ──────────────────────────────────────────────────────

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ── Google login (optional) ──────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Seeded accounts (created on first start) ─────────────────
# Passwords: 8+ chars with lowercase, uppercase, number and special character.
# Remove the TESTER_* accounts in production.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@123

TESTER_ADMIN_NAME=Tester Admin
TESTER_ADMIN_EMAIL=testeradmin@example.com
TESTER_ADMIN_PASSWORD=ChangeMe@123

TESTER_MANAGER_NAME=Tester Manager
TESTER_MANAGER_EMAIL=testermanager@example.com
TESTER_MANAGER_PASSWORD=ChangeMe@123

TESTER_TECHNICIAN_NAME=Tester Technician
TESTER_TECHNICIAN_EMAIL=testertechnician@example.com
TESTER_TECHNICIAN_PASSWORD=ChangeMe@123

# ── Redis (OTP storage) ──────────────────────────────────────
REDIS_USER=default
REDIS_PASSWORD=your-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Email (SMTP) ─────────────────────────────────────────────
# Gmail: enable 2-step verification, then create an "App password".
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_SENDER=your-email@gmail.com

# ── Cloudinary (file uploads) ────────────────────────────────
# https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── bKash (tokenized checkout, sandbox) ──────────────────────
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
# API base URL only. The code appends /payment/callback itself.
BKASH_CALLBACK_URL=http://localhost:5000/api/v1

# ── Billing ──────────────────────────────────────────────────
LABOR_RATE_PER_HOUR=500
TAX_RATE_PERCENT=0
